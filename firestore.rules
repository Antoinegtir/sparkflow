rules_version = '2';

// Each signed-in user reads and writes only their own saved apps (lib/web/cloud-apps.ts) and preferences.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/apps/{appId} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['slug', 'name', 'status', 'screenCount', 'createdAt', 'native', 'previewDevice', 'cover', 'coverKey', 'bundleId', 'projectId', 'updatedAt'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 80
        && request.resource.data.slug is string && request.resource.data.slug.size() <= 80
        // The cover is a link to Cloud Storage (storage.rules), not the image itself.
        && (!('cover' in request.resource.data) || (request.resource.data.cover is string && request.resource.data.cover.size() < 2000));
    }
    // Their preferences (lib/web/user-prefs.ts).
    match /users/{uid}/settings/prefs {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['idPrefix', 'developerName', 'repoPrivate', 'orientation', 'updatedAt'])
        && request.resource.data.idPrefix is string && request.resource.data.idPrefix.size() <= 60
        && request.resource.data.developerName is string && request.resource.data.developerName.size() <= 80
        && request.resource.data.repoPrivate is bool
        && request.resource.data.orientation in ['portrait', 'landscape', 'default'];
    }
    // Sharing (lib/share/firebase.ts): each sparkflow server, an anonymous account, publishes its
    // tunnel link; guests leave single-use identity proofs only that server reads, so their uid and
    // GitHub id come from signed token claims and their ID token never leaves the browser.
    match /servers/{serverUid} {
      allow get: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == serverUid
        && request.auth.token.firebase.sign_in_provider == 'anonymous'
        && request.resource.data.keys().hasOnly(['url','seenAt','version'])
        && (request.resource.data.url == null || (request.resource.data.url is string && request.resource.data.url.matches('https://[a-z0-9-]{1,80}[.]trycloudflare[.]com')))
        && request.resource.data.version is string && request.resource.data.version.size() <= 20
        && request.resource.data.seenAt == request.time;
      allow delete: if request.auth != null && request.auth.uid == serverUid;
      match /proofs/{proofId} {
        allow create: if request.auth != null
          && request.auth.token.firebase.sign_in_provider in ['github.com','google.com']
          && proofId.matches('[A-Za-z0-9_-]{22,64}')
          && request.resource.data.keys().hasOnly(['uid','gh','email','at'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.gh == request.auth.token.firebase.identities.get('github.com', [''])[0]
          && request.resource.data.email == request.auth.token.get('email', '')
          && request.resource.data.at == request.time;
        allow get, delete: if request.auth != null && request.auth.uid == serverUid;
      }
    }
  }
}
