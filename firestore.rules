rules_version = '2';

// Each signed-in user reads and writes only their own saved apps (lib/web/cloud-apps.ts).
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/apps/{appId} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['slug', 'name', 'status', 'screenCount', 'createdAt', 'native', 'previewDevice', 'cover', 'coverKey', 'updatedAt'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 80
        && request.resource.data.slug is string && request.resource.data.slug.size() <= 80
        && (!('cover' in request.resource.data) || (request.resource.data.cover is string && request.resource.data.cover.size() < 300000));
    }
  }
}
