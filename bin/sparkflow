#!/usr/bin/env bash
# Sparkflow on your computer. Installed by https://sparkflow-ai.web.app/install.sh
#
#   sparkflow            start the server and connect it to the hosted site
#   sparkflow key        set or change your Muse Spark API key (kept on this computer)
#   sparkflow folder     choose where your apps live (default ~/.sparkflow/data)
#   sparkflow doctor     check what Sparkflow needs (Node, Xcode, cloudflared…)
#   sparkflow update     install the latest release (or: sparkflow update v0.3.0)
#   sparkflow version    installed version
#   sparkflow uninstall  remove Sparkflow (keeps your apps unless --all)
set -euo pipefail

HOME_DIR="${SPARKFLOW_HOME:-$HOME/.sparkflow}"
APP="$HOME_DIR/current"
SITE="${SPARKFLOW_SITE:-https://sparkflow-ai.web.app}"
# Node and cloudflared the installer downloaded when they were missing.
export PATH="$HOME_DIR/tools/bin:$HOME_DIR/tools/node/bin:$PATH"

bold() { printf '\033[1m%s\033[0m\n' "$*"; }
ok() { printf '  \033[32m✓\033[0m %s\n' "$*"; }
warn() { printf '  \033[33m!\033[0m %s\n' "$*"; }
bad() { printf '  \033[31m✗\033[0m %s\n' "$*"; }

# Where the apps live: SPARKFLOW_DATA_DIR in ~/.sparkflow/.env (`sparkflow folder`), else ~/.sparkflow/data.
data_dir() {
  local d
  d="$(sed -n 's/^SPARKFLOW_DATA_DIR=//p' "$HOME_DIR/.env" 2>/dev/null | tail -1)"
  echo "${d:-$HOME_DIR/data}"
}

version() { node -p "require('$APP/package.json').version" 2>/dev/null || echo "not installed"; }

# Android apps (optional): the SDK, a Java for Gradle (Android Studio ships one) and an emulator.
android_checks() {
  local sdk="${ANDROID_HOME:-${ANDROID_SDK_ROOT:-$HOME/Library/Android/sdk}}" java="" j avds
  [ -d "$sdk" ] || sdk="$HOME/Android/Sdk"
  if [ -x "$sdk/platform-tools/adb" ] || command -v adb >/dev/null 2>&1; then
    ok "Android SDK (adb)"
  else
    warn "Android SDK not found (optional): install Android Studio to build Android apps"
    return 0
  fi
  for j in "${JAVA_HOME:-}" "/Applications/Android Studio.app/Contents/jbr/Contents/Home" "$HOME/Applications/Android Studio.app/Contents/jbr/Contents/Home"; do
    if [ -n "$j" ] && [ -x "$j/bin/java" ]; then java="$j"; break; fi
  done
  if [ -n "$java" ] || /usr/libexec/java_home >/dev/null 2>&1; then
    ok "Java for Android builds"
  else
    warn "No Java for Android builds: install Android Studio (it ships one) or a JDK 17+"
  fi
  if [ -x "$sdk/emulator/emulator" ]; then
    avds=$("$sdk/emulator/emulator" -list-avds 2>/dev/null | grep -v '^INFO' | grep -c . || true)
    if [ "${avds:-0}" -gt 0 ]; then
      ok "Android emulator ($avds virtual device$([ "$avds" = 1 ] || echo s))"
    else
      warn "No Android virtual device: create one in Android Studio › Device Manager"
    fi
  else
    warn "Android emulator not installed: Android Studio › SDK Manager › Android Emulator"
  fi
}

# Same checks as the installer, with the reason for each. Exit 1 if a required one fails.
doctor() {
  local failed=0
  bold "Sparkflow $(version)"
  if command -v node >/dev/null; then
    local major; major=$(node -p 'process.versions.node.split(".")[0]')
    if [ "$major" -ge 20 ]; then ok "Node $(node -v)"; else bad "Node $(node -v): 20 or newer needed (brew install node)"; failed=1; fi
  else bad "Node not found: brew install node"; failed=1; fi
  command -v npm >/dev/null && ok "npm $(npm -v)" || { bad "npm not found"; failed=1; }
  command -v git >/dev/null && ok "git $(git --version | awk '{print $3}')" || { bad "git not found (xcode-select --install)"; failed=1; }
  command -v cloudflared >/dev/null && ok "cloudflared (tunnel to the hosted site)" || { bad "cloudflared not found: brew install cloudflared"; failed=1; }
  if [ "$(uname)" = "Darwin" ]; then
    xcode-select -p >/dev/null 2>&1 && ok "Xcode command line tools" || { bad "Xcode command line tools missing: xcode-select --install"; failed=1; }
    if xcrun simctl help >/dev/null 2>&1; then ok "Xcode with iOS Simulator (native projects)"; else warn "Full Xcode not found: building Expo apps works, the iOS Simulator view does not"; fi
  else
    warn "Not macOS: the iOS Simulator features are unavailable"
  fi
  android_checks
  if command -v gh >/dev/null; then
    gh auth status >/dev/null 2>&1 && ok "GitHub CLI (signed in)" || warn "GitHub CLI not signed in (to create repositories): gh auth login"
  else
    warn "GitHub CLI not found (optional, to put your apps on GitHub): brew install gh"
  fi
  command -v watchman >/dev/null && ok "watchman" || warn "watchman not found (optional, faster reloads): brew install watchman"
  [ -f "$HOME_DIR/.env" ] && grep -q '^MODEL_API_KEY=.' "$HOME_DIR/.env" && ok "Muse Spark API key set (on this computer only)" || warn "No Muse Spark API key: demo mode (sparkflow key to add one)"
  ok "Apps in $(data_dir | sed "s|^$HOME|~|") (sparkflow folder to change)"
  [ -d "$APP/.next-server" ] && ok "Server build present" || { bad "Server build missing: sparkflow update"; failed=1; }
  return $failed
}

case "${1:-start}" in
  start)
    [ -d "$APP" ] || { echo "Sparkflow is not installed. curl -fsSL $SITE/install.sh | bash"; exit 1; }
    doctor >/dev/null || { doctor; exit 1; }
    cd "$APP"
    export SPARKFLOW_DATA_DIR="$(data_dir)" SPARKFLOW_SITE="$SITE"
    exec node scripts/remote.mjs
    ;;
  key)
    cd "$APP" && exec node scripts/remote.mjs --key
    ;;
  folder)
    cd "$APP" && SPARKFLOW_DATA_DIR="$(data_dir)" exec node scripts/remote.mjs --folder
    ;;
  doctor) doctor ;;
  version | --version | -v) version ;;
  update) curl -fsSL "$SITE/install.sh" | bash -s -- "${2:-}" ;;
  uninstall)
    APPS="$(data_dir)"
    rm -rf "$HOME_DIR/versions" "$HOME_DIR/current" "$HOME_DIR/bin"
    [ "${2:-}" = "--all" ] && rm -rf "$HOME_DIR"
    rm -f "$HOME/.local/bin/sparkflow"
    echo "Sparkflow removed.$([ -d "$APPS" ] && echo " Your apps are still in $APPS.")"
    ;;
  help | --help | -h) sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//' ;;
  *) echo "Unknown command: $1 (sparkflow help)"; exit 1 ;;
esac
