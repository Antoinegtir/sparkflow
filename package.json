{
  "name": "sparkflow",
  "version": "0.2.2",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx scripts/smoke.ts",
    "eval": "tsx scripts/eval.ts",
    "setup": "npm --prefix templates/expo-base install && npx playwright install chromium",
    "build:static": "node scripts/build-static.mjs",
    "deploy": "npm run build:static && firebase deploy --only hosting",
    "remote": "node scripts/remote.mjs",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.6",
    "@grpc/proto-loader": "^0.8.1",
    "@xyflow/react": "^12",
    "clsx": "^2.1.1",
    "firebase": "^13.1.0",
    "lucide-react": "latest",
    "material-icon-theme": "^5.40.0",
    "modal": "^0.11.1",
    "motion": "latest",
    "next": "16.4.3",
    "playwright": "^1.64.1",
    "qrcode.react": "^4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "type": "module"
}
